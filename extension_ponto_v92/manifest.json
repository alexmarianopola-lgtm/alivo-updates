{
  "manifest_version": 3,
  "name": "ALIYVO Ponto Guard",
  "version": "2.0.0",
  "description": "Protege o acesso ao Sankhya quando existe uma batida de ponto pendente no ALIYVO.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://somaforce.nuvemdatacom.com.br/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://somaforce.nuvemdatacom.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ALIYVO Ponto Guard"
  }
}