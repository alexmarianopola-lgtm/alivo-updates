+
+    def _refresh_freight_services(self,text):
+        place=resolve_freight_city(text)
+        previous=self.freight_carrier.currentData()
+        self.freight_carrier.blockSignals(True)
+        self.freight_carrier.clear()
+        if not place.get("ok"):
+            self.freight_carrier.addItem("Primeiro escolha a cidade",None)
+            self.freight_carrier.blockSignals(False)
+            self._last_freight_quote=None
+            self.freight_copy_btn.setEnabled(False)
+            self.freight_result.setText("Escolha uma cidade da lista para ver as transportadoras.")
+            self.freight_result.setStyleSheet(
+                "background:#F4F7FA;border:1px solid #D5DEE7;border-radius:8px;"
+                "padding:12px;color:#435466;"
+            )
+            return
+        services=services_for_uf(place["uf"])
+        selected=-1
+        for service in services:
+            self.freight_carrier.addItem(service.label,service.key)
+            if service.key==previous:
+                selected=self.freight_carrier.count()-1
+        self.freight_carrier.setCurrentIndex(selected if selected>=0 else (0 if services else -1))
+        self.freight_carrier.blockSignals(False)
+        self._schedule_freight_calculation()
+
+    def _schedule_freight_calculation(self,*_args):
+        try:self._freight_timer.start()
+        except Exception:pass
+
+    def _auto_calculate_freight(self):
+        if (
+            self.freight_city.currentText().strip()
+            and self.freight_carrier.currentData()
+            and self.freight_value.text().strip()
+        ):
+            self.calcular_frete(silent=True)
+
+    def _set_freight_error(self,message):
+        self._last_freight_quote=None
+        self.freight_copy_btn.setEnabled(False)
+        self.freight_result.setStyleSheet(
+            "background:#FFF1F1;border:1px solid #F2A4A4;border-radius:8px;"
+            "padding:12px;color:#9F1D1D;font-weight:600;"
+        )
+        self.freight_result.setText("⚠ "+str(message))
+
+    def calcular_frete(self,silent=False):
+        quote=quote_freight(
+            self.freight_city.currentText(),
+            self.freight_carrier.currentData(),
+            self.freight_value.text(),
+        )
+        if not quote.get("ok"):
+            if not silent:self._set_freight_error(quote.get("reason","Confira os dados."))
+            return
+
+        self._last_freight_quote=quote
+        self.freight_copy_btn.setEnabled(True)
+        detail=(
+            f"<div style='font-size:11px;margin-top:5px'>"
+            f"{quote['city']} / {quote['uf']}<br>"
+            f"{quote['carrier']} · {quote['branch']} · cód. {quote['code']}<br>"
+            f"Corte: <b>{quote['cutoff']}</b>"
+            + (f"<br>{quote['note']}" if quote.get("note") else "")
+            + "</div>"
+        )
+        if quote["status"]=="free":
+            self.freight_result.setStyleSheet(
+                "background:#E7F7ED;border:2px solid #39A96B;border-radius:8px;"
+                "padding:12px;color:#126338;"
+            )
+            self.freight_result.setText(
+                "<div style='font-size:18px;font-weight:800'>🟢 FRETE GRÁTIS</div>"
+                f"<div>Pedido: <b>{freight_brl(quote['value'])}</b></div>"+detail
+            )
+        elif quote["status"]=="paid":
+            self.freight_result.setStyleSheet(
+                "background:#FFF4D6;border:2px solid #E8A72C;border-radius:8px;"
+                "padding:12px;color:#8A5200;"
+            )
+            missing=""
+            if quote.get("missing") is not None and quote["missing"]>0:
+                missing=(
+                    f"<div style='margin-top:7px'>Faltam <b>{freight_brl(quote['missing'])}</b>"
+                    " em produtos para frete grátis.</div>"
+                )
+            self.freight_result.setText(
+                f"<div style='font-size:18px;font-weight:800'>🟠 FRETE {freight_brl(quote['fee'])}</div>"
+                f"<div>Pedido: <b>{freight_brl(quote['value'])}</b></div>"+missing+detail
+            )
+        else:
+            self.freight_result.setStyleSheet(
+                "background:#FFF0E5;border:2px solid #E47A2E;border-radius:8px;"
+                "padding:12px;color:#873A0A;"
+            )
+            missing=""
+            if quote.get("missing") is not None and quote["missing"]>0:
+                missing=f"<div>Faltam <b>{freight_brl(quote['missing'])}</b> para o mínimo.</div>"
+            self.freight_result.setText(
+                "<div style='font-size:17px;font-weight:800'>🟠 CONFIRMAR FRETE</div>"
+                "<div>Valor abaixo do mínimo ou regra em negociação.</div>"+missing+detail
+            )
