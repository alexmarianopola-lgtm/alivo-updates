+    def _place_freight_message_in_whatsapp(self,text):
+        """Preenche a conversa aberta; o vendedor revisa e confirma o envio."""
+        payload=json.dumps(str(text or ""),ensure_ascii=False)
+        js=r"""
+        ((text) => {
+          try {
+            const main=document.querySelector("#main");
+            if(!main) return {ok:false,error:"Nenhuma conversa aberta"};
+            const footer=main.querySelector("footer") || main;
+            const editor=
+              footer.querySelector("[contenteditable='true'][role='textbox']") ||
+              footer.querySelector("[contenteditable='true']");
+            if(!editor) return {ok:false,error:"Campo de mensagem não localizado"};
+            editor.focus();
+            const selection=window.getSelection();
+            const range=document.createRange();
+            range.selectNodeContents(editor);
+            selection.removeAllRanges();
+            selection.addRange(range);
+            document.execCommand("delete",false,null);
+            if((editor.innerText || editor.textContent || "").trim()){
+              editor.textContent="";
+              editor.dispatchEvent(new InputEvent("input",{
+                bubbles:true,inputType:"deleteContentBackward"
+              }));
+            }
+            editor.focus();
+            document.execCommand("insertText",false,text);
+            editor.dispatchEvent(new InputEvent("input",{
+              bubbles:true,inputType:"insertText",data:text
+            }));
+            return {ok:true};
+          } catch(error) {
+            return {ok:false,error:String(error)};
+          }
+        })(%TEXT%);
+        """.replace("%TEXT%",payload)
+        try:
+            self.web.page().runJavaScript(js,self._after_freight_message_in_whatsapp)
+        except Exception as error:
+            self._after_freight_message_in_whatsapp({"ok":False,"error":str(error)})
+
+    def _after_freight_message_in_whatsapp(self,result):
+        if result and result.get("ok"):
+            self.prazo_panel.freight_whatsapp_btn.setText("✅ Pronto no WhatsApp")
+            QTimer.singleShot(
+                1700,
+                lambda:self.prazo_panel.freight_whatsapp_btn.setText("💬 Colocar no WhatsApp")
+            )
+            return
+        QMessageBox.warning(
+            self,
+            "WhatsApp",
+            (result or {}).get("error","Não consegui preencher a conversa aberta."),
+        )
