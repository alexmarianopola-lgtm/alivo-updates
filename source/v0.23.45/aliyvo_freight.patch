+def payment_terms(order_value) -> dict:
+    value = parse_brl(order_value)
+    if value is None:
+        return {"ok": False, "reason": "Informe um valor valido."}
+    minimum, average_days, options = PAYMENT_RANGES[0]
+    for candidate in PAYMENT_RANGES:
+        if value >= candidate[0]:
+            minimum, average_days, options = candidate
+        else:
+            break
+    return {
+        "ok": True,
+        "value": value,
+        "minimum": minimum,
+        "average_days": average_days,
+        "options": list(options),
+    }
