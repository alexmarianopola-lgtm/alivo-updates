+                border-radius:7px;padding:8px 13px;font-weight:700;
+            }
+            QWidget#purchasePortalBar QPushButton:hover{
+                background:#0D303B;border-color:#20E983;
+            }
+        """)
+        self.setCentralWidget(central)
+        lay=QVBoxLayout(central)
+        lay.setContentsMargins(0,0,0,0)
+        lay.setSpacing(0)
+
+        bar=QWidget(central)
+        bar.setObjectName("purchasePortalBar")
+        row=QHBoxLayout(bar)
+        row.setContentsMargins(16,9,12,9)
+        row.setSpacing(8)
+
+        title=QLabel("🛒  PEDIDO AO COMPRADOR")
+        title.setStyleSheet("font-size:16px;font-weight:900;color:#FFFFFF;")
+        row.addWidget(title)
+        self.status=QLabel("Sessão protegida e salva neste computador • sem consumo de API")
+        self.status.setStyleSheet("font-size:10px;color:#87DDBE;padding-left:10px;")
+        row.addWidget(self.status)
+        row.addStretch(1)
+
+        self.home_btn=QPushButton("⌂ Início")
+        self.reload_btn=QPushButton("↻ Atualizar")
+        self.external_btn=QPushButton("↗ Abrir no navegador")
+        self.close_btn=QPushButton("Fechar")
+        row.addWidget(self.home_btn)
+        row.addWidget(self.reload_btn)
+        row.addWidget(self.external_btn)
+        row.addWidget(self.close_btn)
+        lay.addWidget(bar)
+
+        self.web=QtWebView2Widget(
+            url=self.URL,
+            user_agent=None,
+            debug=False,
+            context_menus=True,
+            transparent=False,
+            background_color="#FFFFFF",
+            handle_new_window=True,
+            lazyload=False,
+            user_data_folder=str(PURCHASE_PROFILE_DIR),
+            no_local_storage=False,
+            fullscreen_support=True,
+            parent=None,
+        )
+        lay.addWidget(self.web,1)
+
+        self.home_btn.clicked.connect(self._go_home)
+        self.reload_btn.clicked.connect(self._reload)
+        self.external_btn.clicked.connect(self._open_external)
+        self.close_btn.clicked.connect(self.hide)
+        try:
+            self.web.bridge.initialization_done.connect(self._initialized)
+        except Exception:
+            pass
+        try:
+            self.web.bridge.domContentLoaded.connect(self._loaded)
+        except Exception:
+            pass
+
+    def _initialized(self,*args):
+        try:
+            if args and args[0] is False:
+                self.status.setText("Não foi possível iniciar a tela interna • use Abrir no navegador")
+                return
+        except Exception:
+            pass
+        self.status.setText("Abrindo Pede pro William…")
+
+    def _loaded(self,*args):
+        self.status.setText("Pronto • sua sessão fica salva neste computador • sem consumo de API")
+
+    def _go_home(self):
+        try:
+            self.status.setText("Abrindo Pede pro William…")
+            self.web.load_url(self.URL)
+        except Exception:
+            self._open_external()
+
+    def _reload(self):
+        try:
+            self.status.setText("Atualizando pedidos…")
+            self.web.reload()
+        except Exception:
+            self._go_home()
+
+    def _open_external(self):
+        try:
+            webbrowser.open(self.URL)
+        except Exception as exc:
+            QMessageBox.warning(
+                self,
+                "Pedido ao comprador",
+                "Não consegui abrir o navegador: "+str(exc),
+            )
+
+    def open_portal(self):
+        self.showMaximized()
+        self.raise_()
+        self.activateWindow()
+
+    def closeEvent(self,event):
+        # Fechar só esconde a janela. A sessão e a página continuam prontas.
+        try:
+            event.ignore()
+        except Exception:
+            pass
+        self.hide()
+
